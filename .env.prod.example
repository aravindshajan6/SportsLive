# Sportscast production environment.
#
# Copy to /opt/sportscast/.env — it MUST sit in the same directory as
# compose.prod.yml. Compose resolves ${VAR} from a .env in the compose file's
# own directory; env_file: only injects into containers. Putting it elsewhere
# gives "required variable X is missing a value", which does not explain itself.
#
# Do not commit the real file. chmod 600 it on the server.

# --- secrets (required) --------------------------------------------------
# Long random string used to sign JWTs. The API REFUSES TO START in production
# without it. Generate with:  openssl rand -hex 32
JWT_SECRET=

# RapidAPI key for livescore-sports.p.rapidapi.com.
# Free plan: 500 requests/month. Without it, /api/matches returns UPSTREAM errors.
RAPIDAPI_KEY=

# --- image tags (optional) -----------------------------------------------
# Left unset, compose uses :latest. Pin both to a sha- tag to roll back:
#   WEB_IMAGE=ghcr.io/aravindshajan6/sportscast-web:sha-4302479
#   API_IMAGE=ghcr.io/aravindshajan6/sportscast-api:sha-4302479
WEB_IMAGE=ghcr.io/aravindshajan6/sportscast-web:latest
API_IMAGE=ghcr.io/aravindshajan6/sportscast-api:latest

# --- deliberately NOT set here -------------------------------------------
# MONGO_URI, CORS_ORIGINS, TRUST_PROXY, NODE_OPTIONS and PORT are pinned in
# compose.prod.yml. MONGO_URI in particular is fixed to the CONTAINER name
# (sportscast-mongo) so the generic-name collision cannot be reintroduced here.
