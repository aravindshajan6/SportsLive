# Copy to backend/.env and fill in real values. Never commit .env.
PORT=4000
# MongoDB connection string (legacy name `mongoAtlasURI` is also honoured)
MONGO_URI=mongodb://127.0.0.1:27017/sportscast
# Long random string used to sign JWTs (legacy name `SECRET_KEY` is also honoured)
JWT_SECRET=change-me-to-a-long-random-string
# RapidAPI key for livescore-sports.p.rapidapi.com
RAPIDAPI_KEY=your-rapidapi-key
# Comma-separated list of allowed browser origins (omit or leave empty to allow any origin)
CORS_ORIGINS=http://localhost:5173,https://sports-live-api.netlify.app
NODE_ENV=development
# Optional: debug|info|warn|error|silent
# LOG_LEVEL=info
